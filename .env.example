# Proofy client environment. Copy to .env.local (git-ignored) and fill in.
# Only these two VITE_ vars reach the browser. They are public by design (RLS guards the data).
# Never put a service-role key, database password or any other secret in a VITE_ var or in this repo.
#
# Local: `npm run db:start` prints the local API URL and anon key.
# Hosted: Supabase Dashboard -> Project Settings -> API.
# Deployed builds get these from Vercel env settings (Preview scope = proofy-dev,
# Production scope = proofy-prod), not from this file.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-public-key
