{
  "name": "proofy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "gen:types": "supabase gen types typescript --local > src/adapters/supabase/database.types.ts"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.119.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
